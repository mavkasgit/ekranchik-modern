<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EkranchikAllInOne</AssemblyName>
    <ApplicationIcon>..\launcher.ico</ApplicationIcon>
    <Description>Ekranchik All-in-One: backend + kiosk screen + settings in one app</Description>
    <!-- WebView2 тянет свой Wpf-вариант с WindowsBase 5.0 — шум MSB3277
         о unified-версиях; в WinForms-приложении Wpf.dll не используется. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
  </ItemGroup>

  <ItemGroup>
    <!-- Общие с киоском модули: UpdateChecker.cs исторически, KioskForm.cs и
         SettingsForm.cs — слияние киоска в полный режим (issue #9). -->
    <Compile Include="..\UpdateChecker.cs" Link="UpdateChecker.cs" />
    <Compile Include="..\KioskForm.cs" Link="KioskForm.cs" />
    <Compile Include="..\SettingsForm.cs" Link="SettingsForm.cs" />
  </ItemGroup>

</Project>
