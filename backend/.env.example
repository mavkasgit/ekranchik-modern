# Ekranchik Modern - Environment Configuration
# Copy this file to .env and fill in the values

# ============================================================================
# ОСНОВНЫЕ НАСТРОЙКИ
# ============================================================================

# Application
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database (stored in static folder)
DATABASE_URL=sqlite+aiosqlite:///../static/ekranchik.db

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Static files
STATIC_DIR=../static
IMAGES_DIR=../static/images

# ============================================================================
# ЖУРНАЛ ПОДВЕСОВ (issue #34)
# ============================================================================
# Файл с историей проходов по линии: пишет само приложение, одинаково в
# dev, контейнере и exe. Каталог по умолчанию — <каталог данных>/journal,
# то есть рядом с ekranchik.db (в контейнере это примонтированный том).
# Сутки на файл, потолок размера докатывается следующим файлом той же суток.
#JOURNAL_DIR=
JOURNAL_RETENTION_DAYS=30
JOURNAL_MAX_FILE_BYTES=33554432
# Как часто фоновая задача дописывает новые проходы, секунд
JOURNAL_FLUSH_INTERVAL=30

# Frontend SPA (full mode, ADR 0002): served by FastAPI on the same port when the folder exists
FRONTEND_DIST_DIR=../frontend/dist

# Photo upload
MAX_UPLOAD_SIZE=10485760


# ============================================================================
# ПЕРЕКЛЮЧАТЕЛЬ РЕЖИМА РАБОТЫ
# ============================================================================
# Используйте кнопку в лаунчере для переключения между режимами
# false = РАБОЧИЙ режим (реальные данные)
# true  = ТЕСТОВЫЙ режим (локальные данные)
SIMULATION_ENABLED=false


# ============================================================================
# РАБОЧИЙ РЕЖИМ - Реальные данные производства
# ============================================================================

# OPC UA - Реальный сервер
OPCUA_ENABLED=true
OPCUA_ENDPOINT=opc.tcp://172.17.11.115:4840/
OPCUA_POLL_INTERVAL=1.0

# Excel - Начальный путь к сетевому файлу (используется при первом запуске в рабочем режиме,
# если не был сохранен выбор пользователя — см. EXCEL_ACTIVE_FILE_NAME)
# UNC-путь к сетевой шаре: dev-хост открывает диск напрямую.
# В контейнере путь переопределяется в infra/compose/docker-compose.prod.yml.
EXCEL_REAL_FILE_PATH=\\172.17.11.7\Оператор\Учет КПЗ 2026.xlsm

# Файл, в котором бэкенд помнит последний введённый путь к книге (каталог
# static, в полном режиме — каталог данных). У сред имя должно быть своё:
# каталог static общий у dev-бэкенда и прод-контейнера. Контейнеру имя задаёт
# infra/compose/docker-compose.prod.yml, в режиме симуляции добавляется `_sim`.
#EXCEL_ACTIVE_FILE_NAME=active_excel.json


# ============================================================================
# ТЕСТОВЫЙ РЕЖИМ - Локальные данные для разработки
# ============================================================================

# OPC UA - Локальный симулятор
OPCUA_SIM_ENDPOINT=opc.tcp://127.0.0.1:4840/freeopcua/server/
OPCUA_SIM_POLL_INTERVAL=1.0

# Excel - Начальный путь к локальному тестовому файлу (используется при первом запуске в тест-режиме,
# если не был сохранен выбор пользователя в static/active_excel_sim.json)
EXCEL_TEST_FILE_PATH=../testdata/Учет КПЗ 2026.xlsm

# ============================================================================
# ПОЛНЫЙ РЕЖИМ (заводская машина без Docker, ADR 0002) — НЕ задавать в dev!
# Сборка: scripts/build-full-package.ps1. backend/.env в пакет НЕ копируется.
# Без явных DATABASE_URL/IMAGES_DIR данные уходят в %LOCALAPPDATA%/Ekranchik/data
# (каталог создаётся при старте, миграции — alembic upgrade head из lifespan).
# EKRANCHIK_*-алиасы выставляет EkranchikAllInOne (#4); голые имена в приоритете:
#EKRANCHIK_DATA_DIR=
#EKRANCHIK_EXCEL_PATH=
#EKRANCHIK_OPCUA_ENDPOINT=
#EKRANCHIK_SIMULATION=
