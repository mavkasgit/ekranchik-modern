{
  "name": "ekranchik-modern",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install-all": "npm install && npm install --prefix frontend",
    "setup:python": "node scripts/setup-python.js",
    "predev": "node scripts/ensure-dev-ports.js",
    "dev": "concurrently --names \"BACKEND,FRONTEND\" -c \"green,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:sim": "concurrently --names \"BACKEND,FRONTEND,SIMULATOR\" -c \"green,cyan,blue\" \"npm run dev:backend:sim\" \"npm run dev:frontend\" \"npm run dev:simulator\"",
    "dev:sim:fast": "concurrently --names \"BACKEND,FRONTEND,SIMULATOR\" -c \"green,cyan,blue\" \"npm run dev:backend:sim:fast\" \"npm run dev:frontend\" \"npm run dev:simulator:fast\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "node scripts/run-python.js --env SIMULATION_ENABLED=false -m uvicorn app.main:app --host 0.0.0.0 --port 8013",
    "dev:backend:sim": "node scripts/run-python.js --env SIMULATION_ENABLED=true -m uvicorn app.main:app --host 0.0.0.0 --port 8013",
    "dev:backend:sim:fast": "node scripts/run-python.js --env SIMULATION_ENABLED=true --env JOURNAL_DIR=../journal-e2e -m uvicorn app.main:app --host 0.0.0.0 --port 8013",
    "dev:simulator": "node scripts/run-python.js opcua_server_simulator.py",
    "dev:simulator:fast": "node scripts/run-python.js --env SIM_PROFILE=fast opcua_server_simulator.py",
    "dev:ports": "node scripts/ensure-dev-ports.js --check",
    "ports:check": "node ../_ports/check-ports.mjs",
    "dev:kill": "node scripts/ensure-dev-ports.js --kill",
    "test:e2e": "playwright test --config=playwright.config.mts",
    "test:e2e:ui": "playwright test --config=playwright.config.mts --ui",
    "chrome:debug": "start chrome --remote-debugging-port=9222 --no-first-run --no-default-browser-check --user-data-dir=\"%CD%\\.chrome-dev-profile\" http://127.0.0.1:5173/opcua"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "knip": "^6.44.1"
  }
}
