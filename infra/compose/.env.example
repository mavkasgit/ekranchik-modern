# Локальные настройки compose для прода. Копируется в .env рядом и НЕ
# попадает в git: здесь пароль от сетевой шары.
#
#   cp infra/compose/.env.example infra/compose/.env
#
# Compose подхватывает .env из каталога этого файла сам — отдельный -f не
# нужен, команда остаётся одна на любой машине:
#
#   docker compose -f infra/compose/docker-compose.prod.yml up -d --build
#
# На Linux-сервере этот файл не нужен: там значения по умолчанию дают тот же
# bind /mnt/ktm-disk, что и раньше.

# --- Windows (Docker Desktop) -------------------------------------------------
# bind-mount сетевого диска с хоста на Windows не работает, и CIFS поднимает
# сам Docker. Тип тома cifs проверен на этой машине: книга видна в контейнере.
EXCEL_VOL_TYPE=cifs
EXCEL_VOL_OPTS=addr=172.17.11.7,guest,ro,vers=3.0,iocharset=utf8,file_mode=0444,dir_mode=0555
EXCEL_VOL_DEVICE=//172.17.11.7/Оператор

# --- Версия сборки ------------------------------------------------------------
# Прокидывается в образы аргументом APP_VERSION. Compose не умеет читать
# файл, поэтому значение повторяет корневой VERSION. На сервере этим не
# пользуются: infra/deploy_prod.sh подставляет его сам из VERSION.
APP_VERSION=1.0.3
